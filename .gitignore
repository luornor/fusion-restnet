# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Model checkpoints (large files)
model_registry/*.pt
model_registry/*.pth
# Keep only releasable multi-source checkpoints in git.
!model_registry/*[Mm]ulti*[Ss]ource*_best.pt
!model_registry/*[Mm]ulti*[Ss]ource*_last.pt
!model_registry/*[Mm]ulti*[Ss]ource*_best.pth
!model_registry/*[Mm]ulti*[Ss]ource*_last.pth
!model_registry/*[Cc]ombined*_best.pt
!model_registry/*[Cc]ombined*_last.pt
!model_registry/*[Cc]ombined*_best.pth
!model_registry/*[Cc]ombined*_last.pth
!model_registry/*[Ll]umina*_best.pt
!model_registry/*[Ll]umina*_last.pt
!model_registry/*[Ll]umina*_best.pth
!model_registry/*[Ll]umina*_last.pth

# Large evaluation arrays regenerated each training run — not useful in git
reports/figures/Y_prob.npy
reports/figures/Y_true.npy

# Combined dataset arrays — regenerate via: python preprocessing/merge_datasets.py
data/combined/X_combined.npy
data/combined/y_combined.npy

# Natural recording waveforms — large raw signals (55 MB each), regenerate via:
#   python preprocessing/prepare_natural.py --mat-dir ../Matlab_Data/Natural/...
data/natural/*.npy

# C extensions
*.so

